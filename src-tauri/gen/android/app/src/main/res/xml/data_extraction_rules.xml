<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same exclusion for cloud backup and device-to-device transfer
     (see backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="cloud-sync/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="cloud-sync/" />
    </device-transfer>
</data-extraction-rules>
