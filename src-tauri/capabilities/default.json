{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "shared capability for the main window (web, Windows desktop and Android)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-stat",
    "opener:default"
  ]
}
