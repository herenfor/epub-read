{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SeLis",
  "build": {
    "frontendDist": "../dist/core-linux"
  },
  "bundle": {
    "targets": ["deb"],
    "category": "Office",
    "shortDescription": "An EPUB, TXT and comic reader",
    "fileAssociations": [
      {
        "ext": ["epub"],
        "mimeType": "application/epub+zip",
        "name": "EPUB book",
        "role": "Viewer"
      }
    ]
  }
}
