{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EPUB Reader",
  "version": "0.1.9-beta.2",
  "identifier": "dev.epubreader.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:core",
    "frontendDist": "../dist/core"
  },
  "app": {
    "windows": [
      {
        "title": "EPUB 阅读器",
        "width": 1080,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "license": "Apache-2.0",
    "resources": [
      "../LICENSE",
      "../NOTICE",
      "../THIRD_PARTY_LICENSES.md",
      "../third-party-licenses/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
