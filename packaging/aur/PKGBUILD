# Maintainer: HeRenFor
# Candidate AUR source package for SeLis (Linux Core).
#
# This is not ready for AUR upload. Upstream has no release tag that contains
# the Linux support yet, so the source below is a local archive generated from
# commit 7081619dfae5a12b0ec8b29425d2d5d2f5175548. See README.md for the exact
# archive command, checksum and the release steps that remain.
#
# The package is named "selis", while the binary, desktop entry and icons keep
# the names produced by the existing Tauri Linux bundle (epub-reader,
# SeLis.desktop). This keeps the desktop entry and GTK window class consistent
# with the observed bundle output.

pkgname=selis
pkgver=0.4.1
pkgrel=1
pkgdesc='An EPUB, TXT and comic reader'
arch=('x86_64')
url='https://github.com/herenfor/epub-read'
license=('GPL-3.0-only')

# Direct ELF dependencies found with readelf on the Linux build, plus the
# desktop integration the package installs. Versions are not pinned.
depends=(
  'cairo'
  'dbus'
  'desktop-file-utils'
  'fontconfig'
  'gcc-libs'
  'gdk-pixbuf2'
  'glib2'
  'gtk3'
  'hicolor-icon-theme'
  'libsoup3'
  'shared-mime-info'
  'webkit2gtk-4.1'
  'xdg-utils'
)

# The runtime libraries below are also present while building (makepkg treats
# depends as installed), so only the separate build tools are listed here.
makedepends=(
  'nodejs'
  'pkgconf'
  'pnpm'
  'rust'
)

# Rust keeps its own release LTO. makepkg's GCC LTO would also affect bundled
# C libraries, whose GCC-only bitcode cannot be consumed by Rust's lld.
options=('!strip' '!debug' '!lto')

# Local review-only archive, not an upstream release URL. The checksum is for
# the exact archive produced by the command in README.md. Replace this source
# and checksum with the official tag archive after such a tag exists.
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('3fe07603ade4b3928a579e5e4a9a3ce7000afdb1d1da7052ee27b63a78d3a1c8')

build() {
  cd "$pkgname-$pkgver"

  export CARGO_TARGET_DIR="$srcdir/target"

  pnpm install --frozen-lockfile --store-dir "$srcdir/pnpm-store"
  bash scripts/build-linux.sh --no-bundle -- --locked
}

package() {
  cd "$pkgname-$pkgver"

  # The upstream binary is named after the Cargo package. Installing it under
  # this name keeps the existing desktop entry and GTK window class coherent.
  install -Dm755 "$srcdir/target/release/epub-reader" \
    "$pkgdir/usr/bin/epub-reader"

  install -Dm644 src-tauri/icons/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/epub-reader.png"
  install -Dm644 src-tauri/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/epub-reader.png"
  install -Dm644 src-tauri/icons/128x128@2x.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/epub-reader.png"

  install -d "$pkgdir/usr/share/licenses/$pkgname/third-party-licenses"
  install -m644 LICENSE LICENSING.md NOTICE THIRD_PARTY_LICENSES.md \
    "$pkgdir/usr/share/licenses/$pkgname/"
  install -m644 third-party-licenses/* \
    "$pkgdir/usr/share/licenses/$pkgname/third-party-licenses/"

  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/SeLis.desktop" <<EOF
[Desktop Entry]
Categories=Education;
Comment=An EPUB, TXT and comic reader
Exec=epub-reader %U
StartupWMClass=epub-reader
Icon=epub-reader
Name=SeLis
Terminal=false
Type=Application
MimeType=application/epub+zip;
Actions=GraphicsCompatibility;

[Desktop Action GraphicsCompatibility]
Name=Graphics Compatibility Mode
Name[zh_CN]=图形兼容模式
Exec=epub-reader --graphics-compatibility
EOF
  chmod 644 "$pkgdir/usr/share/applications/SeLis.desktop"
}
