{
  "app-id": "dev.epubreader.app",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.node22"
  ],
  "command": "epub-reader",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=dri",
    "--socket=pulseaudio",
    "--share=network",
    "--talk-name=org.freedesktop.secrets"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/node22/bin",
    "env": {
      "VITE_EDITION": "core",
      "VITE_APP_PLATFORM": "linux",
      "EPUB_READER_EXPECTED_EDITION": "core",
      "CARGO_TARGET_DIR": "target",
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "modules": [
    {
      "name": "selis",
      "buildsystem": "simple",
      "build-commands": [
        "node scripts/build-frontend.mjs build core",
        "TAURI_CONFIG=\"$(cat src-tauri/tauri.linux-core.conf.json)\" cargo build --manifest-path src-tauri/Cargo.toml --bin epub-reader --release --locked --offline --features core,tauri/custom-protocol",
        "install -Dm755 target/release/epub-reader /app/bin/epub-reader",
        "install -Dm644 packaging/flatpak/dev.epubreader.app.desktop /app/share/applications/dev.epubreader.app.desktop",
        "install -Dm644 packaging/flatpak/dev.epubreader.app.metainfo.xml /app/share/metainfo/dev.epubreader.app.metainfo.xml",
        "install -Dm644 src-tauri/icons/32x32.png /app/share/icons/hicolor/32x32/apps/dev.epubreader.app.png",
        "install -Dm644 src-tauri/icons/128x128.png /app/share/icons/hicolor/128x128/apps/dev.epubreader.app.png",
        "install -Dm644 src-tauri/icons/128x128@2x.png /app/share/icons/hicolor/256x256/apps/dev.epubreader.app.png",
        "install -d /app/share/licenses/selis /app/lib/SeLis/_up_",
        "install -m644 LICENSE LICENSING.md NOTICE THIRD_PARTY_LICENSES.md /app/share/licenses/selis/",
        "cp -r third-party-licenses /app/share/licenses/selis/",
        "cp -r /app/share/licenses/selis/. /app/lib/SeLis/_up_/"
      ],
      "sources": [
        { "type": "archive", "path": "inputs/source.tar.gz" },
        { "type": "archive", "path": "inputs/node-dependencies.tar.gz" },
        { "type": "archive", "path": "inputs/cargo-vendor.tar.gz" },
        {
          "type": "file",
          "path": "cargo-config.toml",
          "dest": ".cargo",
          "dest-filename": "config.toml"
        }
      ]
    }
  ]
}
