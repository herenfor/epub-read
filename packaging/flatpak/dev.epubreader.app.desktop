[Desktop Entry]
Type=Application
Name=SeLis
Comment=Read EPUB books, text files and comics
Exec=epub-reader %U
Icon=dev.epubreader.app
Terminal=false
Categories=Office;
MimeType=application/epub+zip;
Actions=GraphicsCompatibility;

[Desktop Action GraphicsCompatibility]
Name=Graphics Compatibility Mode
Name[zh_CN]=图形兼容模式
Exec=epub-reader --graphics-compatibility
