{
  "name": "epub-reader",
  "private": true,
  "version": "0.2.2",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-frontend.mjs dev core",
    "dev:core": "node scripts/build-frontend.mjs dev core",
    "dev:ai": "node scripts/build-frontend.mjs dev ai",
    "build": "node scripts/build-frontend.mjs build core",
    "build:core": "node scripts/build-frontend.mjs build core",
    "build:ai": "node scripts/build-frontend.mjs build ai",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Edition Core",
    "build:windows:core": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Edition Core",
    "build:windows:ai": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Edition AI",
    "tauri:dev:core": "node scripts/build-frontend.mjs tauri-dev core",
    "tauri:dev:ai": "node scripts/build-frontend.mjs tauri-dev ai",
    "verify:edition:core": "node scripts/verify-edition-artifacts.mjs core",
    "verify:edition:ai": "node scripts/verify-edition-artifacts.mjs ai",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "pack": "node scripts/pack-epub.mjs",
    "check": "tsx scripts/check-book.ts",
    "pw-fonts": "node scripts/setup-pw-fonts.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "fflate": "^0.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xmldom/xmldom": "^0.8.10",
    "linkedom": "^0.18.13",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
