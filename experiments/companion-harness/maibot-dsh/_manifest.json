{
  "manifest_version": 2,
  "id": "local.maibot-dsh-bridge",
  "name": "DSH 后台任务",
  "version": "0.1.0",
  "description": "MaiBot QQ 私聊提交、查询、取消 DSH 原生任务及完成回报。",
  "author": { "name": "EPUB Reader", "url": "https://github.com/herenfor/epub-read" },
  "urls": { "repository": "https://github.com/herenfor/epub-read" },
  "license": "MIT",
  "plugin_type": "extension",
  "host_application": { "min_version": "1.3.15", "max_version": "1.3.99" },
  "sdk": { "min_version": "2.16.0", "max_version": "2.99.99" },
  "capabilities": ["chat.get_stream_by_user_id", "maisaka.proactive.trigger"],
  "i18n": { "default_locale": "zh-CN", "supported_locales": ["zh-CN"] }
}
